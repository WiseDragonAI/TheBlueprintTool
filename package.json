{
  "name": "decision-os",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "decision-os-dev-integration-check": "./bin/decision-os-dev-integration-check.mjs",
    "decision-os-merge-dev": "./bin/decision-os-merge-dev.mjs",
    "decision-os-deploy-relay": "./bin/decision-os-deploy-relay.mjs",
    "decision-os-verify": "./bin/decision-os-verify.mjs",
    "decision-os-workload-status": "./bin/decision-os-workload-status.mjs",
    "decision-os-delivery": "./bin/decision-os-delivery.mjs",
    "decision-os-server": "./bin/decision-os-server.mjs",
    "decision-os-projects-migrate": "./bin/decision-os-projects-migrate.mjs",
    "decision-os-migrate-node": "./bin/decision-os-migrate-node.mjs",
    "decision-os-node": "./bin/decision-os-node.mjs",
    "trace-evidence": "./bin/trace-evidence.mjs",
    "decision-os-trace": "./bin/decision-os-trace.mjs",
    "ledger-cli": "./bin/ledger-cli.mjs",
    "normalize-card-heights": "./bin/normalize-card-heights.mjs",
    "save-html": "./bin/save-html.mjs",
    "download-webpage": "./bin/download-webpage.mjs"
  },
  "scripts": {
    "start:workspace": "node ./bin/decision-os-server.mjs",
    "pull:restart": "node ./bin/decision-os-pull-restart.mjs",
    "save-html": "node ./bin/save-html.mjs",
    "download-webpage": "node ./bin/download-webpage.mjs",
    "typecheck:frontend": "frontend/node_modules/.bin/tsc -p frontend/tsconfig.json --noEmit",
    "typecheck:backend": "backend/node_modules/.bin/tsc -p backend/tsconfig.json --noEmit",
    "test:browser": "TSX_TSCONFIG_PATH=backend/tsconfig.json node --test --test-concurrency=1 --import ./frontend/node_modules/tsx/dist/esm/index.mjs \"tests/browser/**/*.spec.ts\"",
    "verify:live": "node tools/live-verify/cli.mjs",
    "verify:live:summary": "node tools/live-verify/summary.mjs",
    "verify:live:drag-trace": "node tools/live-verify/card-drag-trace-suite.mjs",
    "verify:live:manual-trace": "node tools/live-verify/manual-commit-trace.mjs",
    "coverage:frontend": "cd frontend && node --test --experimental-test-coverage --import tsx \"test/**/*.test.ts\"",
    "coverage:functions:frontend": "node tools/unit-coverage/frontend-summary.mjs",
    "test:front-back": "npm run typecheck:frontend && npm run typecheck:backend && npm test --prefix frontend && npm test --prefix backend && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
